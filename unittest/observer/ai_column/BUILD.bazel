load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

# The metadata of an AI column and the answer validation are pure functions of the
# definition, so they are covered in process instead of through a running server.
cc_library(
    name = "ai_column_schema_cases",
    srcs = ["test_ob_ai_column_schema.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/observer:observer_unit_test_headers",
    ],
)

cc_test(
    name = "test_ob_ai_column_schema",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":ai_column_schema_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "ai_column_util_cases",
    srcs = ["test_ob_ai_column_util.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/observer:observer_unit_test_headers",
    ],
)

cc_test(
    name = "test_ob_ai_column_util",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":ai_column_util_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
